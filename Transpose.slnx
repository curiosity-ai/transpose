<Solution>
  <Folder Name="/Transpose/">
    <Project Path="Transpose/Transpose.Bench/Transpose.Bench.csproj" />
    <!-- Listed so the SDK's targets are editable from the IDE, but never built as part of the
         solution: it is an MSBuild SDK package, not code the toolchain compiles against, and
         building it here fails with NETSDK1199 (its ArtifactsPath cannot be set in a csproj).
         Pack it on its own when releasing: dotnet pack Transpose/Transpose.Build.Target. -->
    <Project Path="Transpose/Transpose.Build.Target/Transpose.Build.Target.csproj">
      <Build Project="false" />
    </Project>
    <Project Path="Transpose/Transpose.Compiler/Transpose.Compiler.csproj" />
    <Project Path="Transpose/Transpose.Compiler.Core/Transpose.Compiler.Core.csproj" />
    <Project Path="Transpose/Transpose.Compiler.Library/Transpose.Compiler.Library.csproj" />
    <Project Path="Transpose/Transpose.Template/Transpose.Template.csproj" />
    <Project Path="Transpose/Transpose.Translator/Transpose.Translator.csproj" />
    <Project Path="Transpose/Transpose.Translator.Tests/Transpose.Translator.Tests.csproj" />
  </Folder>
  <Folder Name="/BCL/">
    <Project Path="BCL/Transpose.BCL/Transpose.BCL.csproj" />
    <Project Path="BCL/Transpose.Core/Transpose.Core.csproj" />
  </Folder>
  <Folder Name="/Packages/">
    <Project Path="Packages/Transpose.Howler/Transpose.Howler.csproj" />
    <Project Path="Packages/Transpose.HttpClient/Transpose.HttpClient.csproj" />
    <Project Path="Packages/Transpose.Newtonsoft.Json/Transpose.Newtonsoft.Json.csproj" />
    <Project Path="Packages/Transpose.Newtonsoft.Json.Tests/Transpose.Newtonsoft.Json.Tests.csproj" />
    <Project Path="Packages/Transpose.P2/Transpose.P2.csproj" />
    <Project Path="Packages/Transpose.Placeholders/Transpose.Placeholders.csproj" />
    <Project Path="Packages/Transpose.WebGL2/Transpose.WebGL2.csproj" />
  </Folder>
</Solution>
