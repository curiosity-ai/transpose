<Project Sdk="Transpose.Build.Target/26.7.3049">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Transpose.HttpClient</AssemblyName>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SkipHtmlGeneration>true</SkipHtmlGeneration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.7.3303" />
    <PackageReference Include="Transpose.Core" Version="26.7.3242" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\logo\transpose.png" Link="transpose.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <PropertyGroup>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageIcon>transpose.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>7.2</LangVersion>
    <PackageId>Transpose.HttpClient</PackageId>
    <Authors>Curiosity GmbH, .NET Foundation and Contributors</Authors>
    <Company>Curiosity GmbH</Company>
    <Description>HttpClient-like for Transpose, the .NET C# to JavaScript compiler 🚀</Description>
    <Copyright>Copyright (c) 2019-2022, Curiosity GmbH. Copyright (c) .NET Foundation and Contributors.</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Version>0.0.42</Version>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/curiosity-ai/transpose</PackageProjectUrl>
  </PropertyGroup>
</Project>
