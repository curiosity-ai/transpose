<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both, deliberately: the translator is referenced by both shipped packages, so it has to offer both.
         The host TFM decides only which runtime has to be installed, never which frameworks
         can be compiled - the Transpose SDK overrides a transpiled project to netstandard2.0
         and NuGetFrameworks reads any moniker. Roll-forward only goes up, so a net11.0-only
         build simply cannot run on .NET 10. Drop net10.0 once that is the intended floor. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Transpose.Translator</RootNamespace>
    <AssemblyName>Transpose.Translator</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime\tps.shim.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the test suite can exercise internals directly, e.g. TransposeAssemblies.PackageVersionOrder. -->
    <InternalsVisibleTo Include="Transpose.Translator.Tests" />
  </ItemGroup>

</Project>
