<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(CustomBeforeTransposeProps)" Condition=" '$(CustomBeforeTransposeProps)' != '' And Exists('$(CustomBeforeTransposeProps)') " />

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition=" '$(MicrosoftCommonPropsHasBeenImported)' != 'true' "/>

  <Import Project="$(CustomAfterTransposeProps)" Condition=" '$(CustomAfterTransposeProps)' != '' And Exists('$(CustomAfterTransposeProps)') " />

  <PropertyGroup>
    <!-- The C# language version an IDE analyses this project with, and the one `tps` compiles it at.
         It has to be defaulted *here*, in the props, because Roslyn's Microsoft.CSharp.Core.targets
         caps an unset LangVersion at the newest version the target framework supports (7.3 for
         netstandard2.0, which is what every Transpose project targets) — and it is imported from
         Sdk.targets below, so a default written there arrives too late to ever apply.

         That cap is about the *framework* a compilation binds against, and a Transpose project binds
         against Transpose.dll and is never handed to csc, so it does not apply: the translator
         supports the latest C# (collection expressions, list patterns, the `field` keyword, ref
         structs, …) whatever the TFM says. Leaving it capped made the IDE report modern C# as an
         error in code `tps` compiles happily — the whole point of setting it.

         A project can still pin an older version with <LangVersion> in its .csproj; `tps` reads the
         same property out of the csproj, so the two stay in step. -->
    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
  </PropertyGroup>


  <Target Name="CheckReSharper" BeforeTargets="PrepareForBuild" Condition="'$(ReSharperBuild)' == 'true'">
    <Error Text="Transpose is not compatible with ReSharper and you should disable it for the project." />
  </Target>
</Project>