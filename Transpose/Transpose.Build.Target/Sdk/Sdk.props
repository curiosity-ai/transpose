<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(CustomBeforeTransposeProps)" Condition=" '$(CustomBeforeTransposeProps)' != '' And Exists('$(CustomBeforeTransposeProps)') " />

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition=" '$(MicrosoftCommonPropsHasBeenImported)' != 'true' "/>

  <Import Project="$(CustomAfterTransposeProps)" Condition=" '$(CustomAfterTransposeProps)' != '' And Exists('$(CustomAfterTransposeProps)') " />

  <Target Name="CheckReSharper" BeforeTargets="PrepareForBuild" Condition="'$(ReSharperBuild)' == 'true'">
    <Error Text="Transpose is not compatible with ReSharper and you should disable it for the project." />
  </Target>
</Project>