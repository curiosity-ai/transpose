<Project Sdk="Microsoft.Build.NoTargets/1.0.40">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Provides targets for Transpose-based projects that compile C# to Javascript</Description>
    <PackageTags>MSBuild MSBuildSdk tps transpose javascript compiler</PackageTags>
    <ArtifactsPath>$(BaseArtifactsPath)$(MSBuildProjectName)\</ArtifactsPath>
    <PackageType>MSBuildSdk</PackageType>
    <PackageId>Transpose.Build.Target</PackageId>
    <Company>Curiosity GmbH</Company>
    <Authors>Curiosity GmbH</Authors>
    <Copyright>Copyright (c) 2019-2022, Curiosity GmbH. All rights reserved.</Copyright>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>./</ContentTargetFolders>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/curiosity-ai/transpose</PackageProjectUrl>
    <PackageIcon>transpose.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Sdk\**\*" Exclude="Sdk\**\bin\**;Sdk\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository README is what ships as the package description on nuget.org; the local
         README.md in this folder is the upstream Microsoft.Build.NoTargets one and is not packed. -->
    <None Include="..\..\logo\transpose.png" Link="transpose.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Link="Transpose.README.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>
</Project>
